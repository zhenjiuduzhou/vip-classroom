{
  "name": "vip-classroom",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "wrangler dev --port 8787",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "cf:build": "tsx scripts/cloudflare-build.ts",
    "cf:deploy": "tsx scripts/cloudflare-deploy.ts",
    "cf:preview": "tsx scripts/cloudflare-preview.ts",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test:e2e": "playwright test",
    "test:integration": "tsx scripts/integration.ts",
    "test:bootstrap": "tsx scripts/bootstrap-integration.ts",
    "seed": "tsx scripts/seed.ts",
    "db:migrate": "wrangler d1 migrations apply classroom --local",
    "test": "vitest run tests",
    "typecheck": "tsc --noEmit",
    "benchmark": "tsx scripts/benchmark.ts",
    "admin": "tsx scripts/admin.ts",
    "check:cloudflare": "wrangler whoami",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "aws4fetch": "^1.0.20",
    "hono": "4.13.8",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.63.0",
    "@types/node": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "^8.3.0",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
